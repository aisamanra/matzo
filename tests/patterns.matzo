(* simple variables *)
f := fn {[x] => x};
f := fn {[_] => x};

(* literals *)
f := fn {["foo"] => "!"};
f := fn {[Bar] => "?"};
f := fn {[55] => "~"};

(* tuples *)
f := fn {[<>] => x};
f := fn {[<x>] => x};
f := fn {[<x,y>] => x};
f := fn {[<x,y,z>] => x};

(* fixed variables *)
f := fn {[fix x] => x x};
f := fn {[<fix x, y>] => x x y y};

(* or-patterns *)
f := fn {[1 | 2 | 3] => x x};
f := fn {[1 | (2 | 3)] => x x y y};
