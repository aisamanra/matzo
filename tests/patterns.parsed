Assn  f Fun(
  x, 
 =>
    Var(x)
)

Assn  f Fun(
  _, 
 =>
    Var(x)
)

Assn  f Fun(
  Str("foo"), 
 =>
    Str("!")
)

Assn  f Fun(
  Bar, 
 =>
    Str("?")
)

Assn  f Fun(
  Num(55), 
 =>
    Str("~")
)

Assn  f Fun(
  Tup( ), 
 =>
    Var(x)
)

Assn  f Fun(
  Tup( x ), 
 =>
    Var(x)
)

Assn  f Fun(
  Tup( x y ), 
 =>
    Var(x)
)

Assn  f Fun(
  Tup( x y z ), 
 =>
    Var(x)
)

Assn  f Fun(
  fix x, 
 =>
    Cat(
      Var(x)
      Var(x)
    )
)

Assn  f Fun(
  Tup( fix x y ), 
 =>
    Cat(
      Var(x)
      Var(x)
      Var(y)
      Var(y)
    )
)

